# URL pública do site (usada em SEO e sitemap)
SITE_URL=http://localhost:3000

# Banco: arquivo local em desenvolvimento; em produção use Turso/libSQL (libsql://...)
DATABASE_URL=file:./ssf.db
DATABASE_AUTH_TOKEN=

# Usados apenas por "npm run admin:create"; remova depois de criar a conta
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Envio de e-mail (código de confirmação do cadastro). Sem isto, em desenvolvimento
# o e-mail aparece no terminal; em produção o cadastro avisa que o envio não está configurado.
RESEND_API_KEY=
MAIL_FROM="Sinagoga Sem Fronteiras <cadastro@seu-dominio>"
